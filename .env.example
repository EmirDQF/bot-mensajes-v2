# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# --- Servidor ---
PORT=3000
# URL pública del servicio (Render la define sola como RENDER_EXTERNAL_URL). Se usa para las URLs de /media.
PUBLIC_BASE_URL=

# --- Clínica activa (archivo config/clinics/<id>.js) ---
ACTIVE_CLINIC=denvari

# --- Teléfonos (formato 51XXXXXXXXX o 9 dígitos; nunca van en el código) ---
# Teléfono de contacto de la clínica que se muestra al paciente
CLINIC_PHONE=
# Recibe las alertas de citas nuevas, urgencias y pase a humano
RECEPTION_ALERT_PHONE=
# Recibe el resumen diario para el dueño de la clínica
OWNER_ALERT_PHONE=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Opcional: tope por intento (ms). Si Gemini no responde, se reintenta 2 veces y luego va el respaldo.
GEMINI_TIMEOUT_MS=12000

# --- WhatsApp Cloud API ---
# Token PERMANENTE de usuario del sistema: Meta Business → Configuración del negocio → Usuarios → Usuarios del
# sistema → Generar token (caducidad "Nunca"; permisos whatsapp_business_messaging y whatsapp_business_management).
# El token de "Configuración de la API" vence a las 24 h: sirve solo para probar. Guía: docs/go-live.md.
WHATSAPP_TOKEN=
# Meta for Developers → tu app → WhatsApp → Configuración de la API → "Identificador del número de teléfono"
WHATSAPP_PHONE_NUMBER_ID=
# Misma pantalla → "Identificador de la cuenta de WhatsApp Business" (WABA). Lo usan npm run meta:*
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta for Developers → tu app → Configuración → Básica → "Clave secreta de la app"
WHATSAPP_APP_SECRET=
# Opcional: misma pantalla → "Identificador de la app". Con él meta:check lee el tipo de token con el token de la app.
META_APP_ID=
# Inventa una frase larga; la misma va en Meta → WhatsApp → Configuración → Webhook → "Token de verificación"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# true en producción: rechaza cualquier POST al webhook que no venga firmado por Meta (usa WHATSAPP_APP_SECRET)
ENFORCE_WHATSAPP_SIGNATURE=true
# Versión de la Graph API de Meta
WHATSAPP_API_VERSION=v21.0

# --- Supabase ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Opcional, solo en tu .env (NO en Render): npm run db:migrate -- --apply aplica las migraciones sin el SQL Editor.
# Supabase → Connect → Connection string → URI (modo "Session pooler"), con tu contraseña de la base de datos.
SUPABASE_DB_URL=

# --- Panel (/panel) ---
# Recepción: Bandeja, Agenda, Métricas y Reporte. Inventa el usuario; contraseña de 12+ caracteres.
PANEL_USER=
PANEL_PASSWORD=
# Dueño: todo lo anterior + ⚙️ Configuración y 🧪 Probador. Usa otro usuario y otra contraseña.
PANEL_OWNER_USER=
PANEL_OWNER_PASSWORD=
# Opcional: secreto extra para firmar las sesiones del panel (si falta, se deriva de las contraseñas).
PANEL_SESSION_SECRET=

# --- Agenda ---
# Minutos mínimos de anticipación para ofrecer un horario hoy (por defecto 60)
APPOINTMENT_MIN_LEAD_MINUTES=60

# --- Automatizaciones (POST /jobs/* desde un cron externo) ---
# Secreto que el cron envía en el header "x-cron-secret". Genera uno largo y aleatorio.
CRON_SECRET=
# Horas sin respuesta antes del mensaje único de retoma (debe ser < 24)
FOLLOW_UP_AFTER_HOURS=20
# Opcional, solo en tu .env: cron-job.org → Settings → API → Create API key. Con ella npm run crons:setup -- --apply
# crea las 6 tareas sola; sin ella imprime la tabla para crearlas a mano.
CRONJOB_API_KEY=

# --- Nombres de plantillas de WhatsApp aprobadas (solo si Meta aprobó otro nombre) ---
WA_TEMPLATE_REMINDER_24H=recordatorio_cita_24h
WA_TEMPLATE_REMINDER_2H=recordatorio_cita_2h
WA_TEMPLATE_REACTIVATION=reactivacion_paciente
WA_TEMPLATE_REVIEW=solicitud_resena
WA_TEMPLATE_DAILY_SUMMARY=resumen_diario
WA_TEMPLATE_WEEKLY_REPORT=reporte_semanal

# --- Garantía comercial ---
# Citas de evaluación confirmadas que debe mostrar el reporte para marcar la garantía como cumplida
GUARANTEE_MIN_CONFIRMED=2

# Modo demo (npm run demo lo activa solo): Supabase EN MEMORIA con pacientes inventados y WhatsApp simulado.
# Nunca en Render: con NODE_ENV=production el arranque falla a propósito. Déjala vacía.
DEMO_MODE=
